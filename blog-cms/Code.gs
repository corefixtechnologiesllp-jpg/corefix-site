function doGet(){const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Blog");const values=sheet.getDataRange().getValues();const headers=values.shift().map(String);const posts=values.map(row=>Object.fromEntries(headers.map((h,i)=>[h,row[i]]))).filter(post=>String(post.published).toLowerCase()!=="false"&&post.slug&&post.title).map(post=>({slug:String(post.slug).trim(),title:String(post.title).trim(),excerpt:String(post.excerpt||"").trim(),content:String(post.content||"").trim(),publishedAt:new Date(post.publishedAt||new Date()).toISOString(),updatedAt:post.updatedAt?new Date(post.updatedAt).toISOString():undefined,author:String(post.author||"Corefix Technologies LLP"),image:String(post.image||""),keywords:String(post.keywords||"").split(",").map(x=>x.trim()).filter(Boolean),published:true}));return ContentService.createTextOutput(JSON.stringify({posts})).setMimeType(ContentService.MimeType.JSON);}
